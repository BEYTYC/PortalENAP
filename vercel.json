{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    },
    {
      "source": "/redirect.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/bajas?cron=recordatorios",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/snies?cron=diario",
      "schedule": "0 13 * * *"
    }
  ],
  "functions": {
    "api/promedios.js": {
      "maxDuration": 60
    },
    "api/snies.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/SNIES",
      "destination": "/index.html"
    },
    {
      "source": "/snies",
      "destination": "/index.html"
    },
    {
      "source": "/promedios",
      "destination": "/index.html"
    },
    {
      "source": "/Promedios",
      "destination": "/index.html"
    }
  ]
}
